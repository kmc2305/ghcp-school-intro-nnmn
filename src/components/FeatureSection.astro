---
import type { ContentCard } from "../data/siteContent";

interface Props {
  title: string;
  intro: string;
  cards: ContentCard[];
  id?: string;
}

const { title, intro, cards, id = "features" } = Astro.props;
---

<section class="section-shell mt-12 md:mt-16" id={id}>
  <div class="mb-6 md:mb-8">
    <p class="tag-chip inline-flex">Features</p>
    <h2 class="display-heading mt-3 text-3xl md:text-4xl">{title}</h2>
    <p class="mt-3 max-w-3xl leading-relaxed">{intro}</p>
  </div>

  <ul class="grid gap-4 md:grid-cols-3">
    {
      cards.map((card) => (
        <li class="glass-card overflow-hidden rounded-[1.5rem] border border-[color:var(--color-line)] bg-white/82 shadow-[var(--shadow-soft)]">
          <img alt={card.image.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" src={card.image.src} />
          <div class="space-y-3 p-5">
            <h3 class="text-xl font-bold leading-snug">{card.title}</h3>
            <p class="text-sm leading-relaxed text-[color:var(--color-ink)]/90">{card.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
