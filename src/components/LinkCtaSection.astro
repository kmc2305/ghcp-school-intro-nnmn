---
import type { OfficialLinkContent } from "../data/siteContent";

interface Props {
  content: OfficialLinkContent;
}

const { content } = Astro.props;
---

<section class="section-shell mt-12 md:mt-16">
  <div class="rounded-[2rem] border border-[color:var(--color-line)] bg-gradient-to-r from-white to-[color:var(--color-sky)] p-8 shadow-[var(--shadow-soft)] md:flex md:items-center md:justify-between md:gap-8">
    <div class="space-y-3">
      <p class="tag-chip inline-flex">Official Info</p>
      <h2 class="display-heading text-2xl leading-tight md:text-3xl">さらに詳しく知りたい方へ</h2>
      <p class="max-w-xl leading-relaxed">{content.note}</p>
    </div>

    <a
      class="mt-5 inline-flex items-center justify-center rounded-full bg-[color:var(--color-ink)] px-6 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[color:var(--color-berry)] md:mt-0"
      href={content.href}
      rel="noreferrer"
      target="_blank"
    >
      {content.label}
    </a>
  </div>
</section>
